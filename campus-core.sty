% Scene photos are 3:2; crop natively to fill without distortion.
\newcommand\NKUphototile[6]{%
 \begin{scope}[shift={(#1,#2)},rotate=#6,transform shape]
  \fill[NKUInk,opacity=.10] ({-#3/2+.7},{-#4/2+.9}) rectangle ({#3/2+.7},{#4/2+.9});
  \fill[white] ({-#3/2-1},{-#4/2-1}) rectangle ({#3/2+1},{#4/2+1});
  \begin{scope}
   \clip ({-#3/2},{-#4/2}) rectangle ({#3/2},{#4/2});
   \pgfmathsetmacro\nku@photowidth{max(#3,1.5*(#4))}
   \node[inner sep=0] at (0,0) {\includegraphics[width=\nku@photowidth mm]{#5}};
  \end{scope}
 \end{scope}}
