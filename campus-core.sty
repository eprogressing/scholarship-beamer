% Native Beamer sections are the single source for the agenda and PDF links.
\newcommand\NKUtocnote[2]{\expandafter\gdef\csname nku@tocnote@#1\endcsname{#2}}
\newsavebox\nku@tocmeasure
\newcount\nku@toccount
\def\nku@counttocline#1#2#3#4#5{\global\advance\nku@toccount by 1}
\def\nku@checktocline#1#2#3#4#5{%
 \ifcsname nku@tocnote@#1\endcsname
 \sbox\nku@tocmeasure{\parbox{.225\paperwidth}{\NKUCoverInfoFont
   \fontsize{\nku@toctitlesize}{29}\selectfont #2}}%
 \ifdim\dimexpr\ht\nku@tocmeasure+\dp\nku@tocmeasure\relax>.085\paperheight
  \PackageWarning{Campus}{Agenda title is too long; use a short section name}%
 \fi
 \sbox\nku@tocmeasure{\parbox{.195\paperwidth}{\NKUCoverTextFont
   \fontsize{\nku@tocnotesize}{18}\selectfont\csname nku@tocnote@#1\endcsname}}%
 \ifdim\dimexpr\ht\nku@tocmeasure+\dp\nku@tocmeasure\relax>.085\paperheight
  \PackageWarning{Campus}{Agenda note exceeds two lines; shorten the chapter subtitle}%
 \fi
 \fi
}
\def\nku@drawtocline#1#2#3#4#5{%
 \pgfmathsetmacro\nku@rowy{\nku@tocfirst-(#1-1)*\nku@tocstep}
 \node[anchor=west,text=NKUPurple!48,inner sep=0,
   font=\NKUCoverInfoFont\fontsize{\nku@tocnumsize}{36}\selectfont]
   at (.425,\nku@rowy) {\ifnum#1<10 0\fi#1};
 \ifcsname nku@tocnote@#1\endcsname
 \node[anchor=west,text=NKUDark,inner sep=0,align=left,text width=.225\paperwidth,
   font=\NKUCoverInfoFont\fontsize{\nku@toctitlesize}{29}\selectfont]
   at (.50,\nku@rowy) {\hyperlink{Navigation#3}{#2}};
 \node[anchor=west,text=NKUGray,inner sep=0,align=left,text width=.195\paperwidth,
   font=\NKUCoverTextFont\fontsize{\nku@tocnotesize}{18}\selectfont]
   at (.74,\nku@rowy) {\csname nku@tocnote@#1\endcsname};
 \else
 \node[anchor=west,text=NKUDark,inner sep=0,align=left,text width=.43\paperwidth,
   font=\NKUCoverInfoFont\fontsize{\nku@toctitlesize}{29}\selectfont]
   at (.50,\nku@rowy) {\hyperlink{Navigation#3}{#2}};
 \fi
 \draw[NKUPurple!16,line width=.4pt] (.415,\nku@rowy-.052)--(.95,\nku@rowy-.052);
}
\newcommand\NKUcontents{%
 \begingroup
 \global\nku@toccount=0
 \begingroup\makeatletter
  \let\beamer@sectionintoc\nku@counttocline
  \InputIfFileExists{\jobname.toc}{}{}
 \endgroup
 \ifnum\nku@toccount>8\PackageWarning{Campus}{Agenda exceeds 8 sections; split it into parts}\fi
  \def\nku@toctitlesize{24}\def\nku@tocnumsize{26}\def\nku@tocnotesize{13.5}
  \def\nku@tocfirst{.79}
  \pgfmathsetmacro\nku@tocstep{.64/max(1,\the\nku@toccount-1)}
  \ifnum\nku@toccount<5
   \def\nku@toctitlesize{26}\def\nku@tocnumsize{33}\def\nku@tocnotesize{14}
   \def\nku@tocfirst{.72}\def\nku@tocstep{.16}
  \fi
  \ifnum\nku@toccount>6
   \def\nku@toctitlesize{22}\def\nku@tocnumsize{28}\def\nku@tocnotesize{12.5}
  \fi
 \begingroup\makeatletter
  \let\beamer@sectionintoc\nku@checktocline
  \InputIfFileExists{\jobname.toc}{}{}
 \endgroup
 \begin{frame}[plain,noframenumbering]
 \begin{NKUcanvas}
  \fill[white] (0,0) rectangle (1,1);
  \begin{scope}
   \clip (0,0) rectangle (.36,1);
   \nku@gradient
   \node[anchor=south west,inner sep=0] at (-.015,0)
    {\includegraphics[height=.66\paperheight]{assets/campus-panorama.pdf}};
  \end{scope}
  \node[anchor=north west,text=white,font=\NKUTitleFont\fontsize{46}{54}\selectfont,
    inner sep=0] at (.055,.89) {目录};
  \node[anchor=north west,text=white,opacity=.6,font=\fontsize{15}{20}\selectfont,
    inner sep=0] at (.062,.75) {CONTENTS};
  % Same 34mm brand, 6mm right and 2mm top margins as the profile page.
  \node[anchor=north east,inner sep=0,outer sep=0] at (.9765625,.9861111)
    {\CampusBrand{34mm}{NKUPurple}};
  \begingroup\makeatletter
   \let\beamer@sectionintoc\nku@drawtocline
   \InputIfFileExists{\jobname.toc}{}{}
  \endgroup
 \end{NKUcanvas}
 \end{frame}
 \endgroup}

\newcommand\NKUchapter[1]{%
 \sbox\nku@chaptermeasure{\parbox{.66\paperwidth}{\raggedleft\fontsize{21}{29}\selectfont #1}}
 \def\nku@chapterdescsize{21}\def\nku@chapterdescleading{29}\def\nku@chapterrule{.31}
 \ifdim\dimexpr\ht\nku@chaptermeasure+\dp\nku@chaptermeasure\relax>13mm
  \def\nku@chapterdescsize{17}\def\nku@chapterdescleading{24}\def\nku@chapterrule{.24}
 \fi
 \begin{frame}[plain,noframenumbering]
 \begin{NKUcanvas}
  \nku@gradient
  \node[anchor=north,inner sep=0] at (.5,.93) {\nku@whitebrand{.15\paperwidth}};
  \node[anchor=west,text=white,opacity=.25,font=\fontsize{154}{164}\selectfont,
    inner sep=0] at (.055,.48) {\ifnum\thesection<10 0\fi\thesection};
  \node[anchor=south east,text=white,align=flush right,text width=.61\paperwidth,
    inner sep=0,font=\NKUTitleFont\fontsize{64}{74}\selectfont] at (.93,.46)
    {\hypersetup{linkcolor=white}\insertsectionhead};
  \node[anchor=north east,text=white,align=flush right,text width=.66\paperwidth,
    inner sep=0,font=\fontsize{\nku@chapterdescsize}{\nku@chapterdescleading}\selectfont] at (.93,.41) {#1};
  \draw[white,line width=.7pt] (.07,\nku@chapterrule) -- (.93,\nku@chapterrule);
 \end{NKUcanvas}
 \end{frame}}
% Optional short agenda note preserves room for longer chapter subtitles.
\newcommand\NKUsection[3][]{\section{#2}%
 \def\nku@tocdescription{#1}%
 \ifx\nku@tocdescription\@empty
  \addtocontents{toc}{\protect\NKUtocnote{\thesection}{\unexpanded{#3}}}%
 \else
  \addtocontents{toc}{\protect\NKUtocnote{\thesection}{\unexpanded{#1}}}%
 \fi
 \NKUchapter{#3}}

\setbeamertemplate{frametitle}{%
 \sbox\nku@framemeasure{\parbox{.81\paperwidth}{\raggedright\bfseries
  \fontsize{22}{28}\selectfont\insertframetitle}}
