  \def\nku@headerline{29mm}\def\nku@headerreserve{20mm}
  \def\nku@subtitletop{25mm}
 \fi
 \ifdim\dimexpr\ht\nku@framemeasure+\dp\nku@framemeasure\relax>22mm
  \PackageWarning{Campus}{Frame title exceeds two lines; shorten it}
 \fi
 % Native Beamer subtitles stay with the title, above the separator.
 \ifx\insertframesubtitle\@empty\else
  \sbox\nku@framesubmeasure{\parbox{.81\paperwidth}{\raggedright
   \fontsize{11}{15}\selectfont\insertframesubtitle}}%
  \ifdim\dimexpr\ht\nku@framesubmeasure+\dp\nku@framesubmeasure\relax>6.5mm
   \PackageWarning{Campus}{Frame subtitle exceeds one line; shorten it}%
  \fi
  \edef\nku@headerline{\the\dimexpr\nku@headerline+3mm\relax}%
  \edef\nku@headerreserve{\the\dimexpr\nku@headerreserve+3mm\relax}%
 \fi
 \begin{tikzpicture}[remember picture,overlay]
  \node[anchor=north west,inner sep=0,text=NKUDark,align=left,
   text width=.81\paperwidth,font=\bfseries\fontsize{22}{28}\selectfont]
   at ([xshift=13mm,yshift=-6.5mm]current page.north west) {\raggedright\insertframetitle};
  \ifx\insertframesubtitle\@empty\else
   \node[anchor=north west,inner sep=0,text=NKUGray,align=left,
    text width=.81\paperwidth,font=\fontsize{11}{15}\selectfont]
    at ([xshift=13mm,yshift=-\nku@subtitletop]current page.north west) {\insertframesubtitle};
  \fi
  \node[anchor=north east,inner sep=0] at ([xshift=-13mm,yshift=-5mm]current page.north east)
    {\nku@seal{9mm}};
  \draw[NKUPurple!18,line width=.4pt]
   ([xshift=13mm,yshift=-\nku@headerline]current page.north west)--
   ([xshift=-13mm,yshift=-\nku@headerline]current page.north east);
 \end{tikzpicture}\vspace{\nku@headerreserve}}
