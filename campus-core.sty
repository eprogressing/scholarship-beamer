\newcount\nku@timelinecount
\newcommand\NKUtimeline[1]{%
 \global\nku@timelinecount=0
 \foreach \yr/\head/\desc in {#1}{\global\advance\nku@timelinecount by 1}
 \ifnum\nku@timelinecount>6\PackageWarning{Campus}{Timeline exceeds 6 entries; split it across slides}\fi
 \begin{tikzpicture}[x=\linewidth,y=1mm]
  \pgfmathsetmacro\nku@eventfirst{.5/max(1,\the\nku@timelinecount)}
  \pgfmathsetlengthmacro\nku@eventwidth{.9*\linewidth/max(1,\the\nku@timelinecount)}
  \draw[NKUPurple!35,line width=1pt] (\nku@eventfirst,0)--({1-\nku@eventfirst},0);
  \foreach \yr/\head/\desc [count=\i] in {#1}{
   \pgfmathsetmacro\nku@eventx{(\i-.5)/\the\nku@timelinecount}
   \fill[NKUPurple] (\nku@eventx,0) circle (1.5mm);
   \node[anchor=south,text=NKUPurple,font=\bfseries\fontsize{20}{25}\selectfont]
     at (\nku@eventx,8) {\yr};
   \node[anchor=north,align=center,text width=\nku@eventwidth,
     font=\fontsize{16}{22}\selectfont] at (\nku@eventx,-8) {\head};
   \node[anchor=north,align=center,text width=\nku@eventwidth,text=NKUGray,
     font=\fontsize{11}{17}\selectfont] at (\nku@eventx,-23) {\desc};
  }
 \end{tikzpicture}}
